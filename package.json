  "description": "Dawnexus — Modern Digital Marketing & AI-Powered Creative Agency",
  "main": "server/index.ts",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"magenta,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --port 3000 --host",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "test": "node --test"
  },
  "keywords": [
    "dawnexus",
    "marketing",
    "ai-video",
    "web-development",
    "seo"
  ],
  "author": "Dawnexus",
