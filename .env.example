# Dawnexus Configuration Example
# Copy this file to .env and adjust variables as needed

# Server & Environment
PORT=3001
NODE_ENV=development

# Administrator Authentication
# Local development password default: 9566
# In production, replace with a strong random passphrase!
ADMIN_PASSWORD=9566
SESSION_SECRET=dawnexus_change_this_to_a_random_32_character_string_in_production

# Database file path (persisted on disk)
DB_PATH=./server/data/dawnexus.sqlite

# Durable production data store (server-side only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:5432/postgres
CRON_SECRET=generate-a-random-secret-at-least-16-characters

# Transactional Email Providers (Resend or SMTP)
# Used for OTP ownership verification and automatic inquiry email alerts.
# Note: The actual recipient email address is configured and verified with OTP 
# directly in the Admin Portal (Notification Email tab) and persisted in SQLite.
#
# Option A: Resend (Recommended for Vercel)
RESEND_API_KEY=
RESEND_FROM="Dawnexus Alerts <onboarding@resend.dev>"
INQUIRY_FROM_EMAIL="Dawnexus Alerts <no-reply@dawnexus.in>"

# Option B: SMTP (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Dawnexus Alerts <no-reply@dawnexus.in>"

# Google Gemini API Configuration (Version 7.1.8 - Server-Side Only)
# API key from Google AI Studio (supports new AQ. format)
GEMINI_API_KEY=
# Configurable model (defaults to gemini-3.6-flash, with automatic fallback)
GEMINI_MODEL=gemini-3.6-flash

# Google Integrations & Token Encryption (AES-256-GCM)
SEO_RESEARCH_ENCRYPTION_KEY=your-32-byte-hex-encryption-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.dawnexus.in/api/admin/seo-research/google/callback

# MCP Server Credentials
MCP_API_KEY=your-mcp-api-key


