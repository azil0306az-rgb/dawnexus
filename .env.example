# Dawnexus Configuration Example
# Copy this file to .env and adjust variables as needed

# Server & Environment
PORT=3001
NODE_ENV=development

# Administrator Authentication
# Local development password default: 9566
# In production, replace with a strong random passphrase!
ADMIN_PASSWORD=9566
SESSION_SECRET=dawnexus_change_this_to_a_random_32_character_string_in_production

# Database file path (persisted on disk)
DB_PATH=./server/data/dawnexus.sqlite

# Optional: Email Notifications (Phase 7)
# When configured, administrative notifications are triggered upon new enquiry arrival.
# Database persistence operates independently and will never fail if email is unconfigured.
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Dawnexus Enquiries <no-reply@dawnexus.in>"

