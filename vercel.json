{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/publish",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/db-health",
      "schedule": "30 2 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/blog/local-seo-google-maps-playbook",
      "destination": "https://www.dawnexus.in/blog/local-seo-playbook-small-businesses",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "dawnexus.in"
        }
      ],
      "destination": "https://www.dawnexus.in/$1",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:png|jpg|jpeg|webp|svg|ico|woff2))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/mcp",
      "destination": "/api/index.ts"
    },
    {
      "source": "/mcp/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/oauth",
      "destination": "/api/index.ts"
    },
    {
      "source": "/oauth/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/services/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/blog",
      "destination": "/api/index.ts"
    },
    {
      "source": "/blog/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/website-cost-calculator",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
